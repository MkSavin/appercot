# syntax=docker/dockerfile:1
FROM golang:1.25-bookworm AS build
ENV CGO_ENABLED=0 GOBIN=/out
RUN --mount=type=cache,id=appercot-minio-go-mod,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=appercot-minio-go-build,target=/root/.cache/go-build,sharing=locked \
    go install github.com/minio/minio@RELEASE.2025-10-15T17-29-55Z \
    && go install github.com/minio/mc@RELEASE.2025-08-13T08-35-41Z

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --uid 10002 --create-home --shell /usr/sbin/nologin minio \
  && install -d -o minio -g minio /data
COPY --from=build /out/minio /out/mc /usr/local/bin/
USER minio
EXPOSE 9000
VOLUME ["/data"]
ENTRYPOINT ["minio"]
