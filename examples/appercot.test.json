{
  "server": {
    "hostname": "127.0.0.1",
    "port": 0,
    "publicDir": "../apps/web/dist"
  },
  "registration": { "enabled": true, "userInvites": true },
  "admin": {
    "username": "admin",
    "password": "${ADMIN_PASSWORD}"
  },
  "users": [
    {
      "id": "user-alice",
      "username": "alice",
      "displayName": "Alice",
      "password": "${ALICE_PASSWORD}"
    }
  ],
  "bots": [
    {
      "id": "bot-echo",
      "username": "echo_bot",
      "name": "Echo",
      "owner": "alice",
      "token": "${ECHO_BOT_TOKEN}",
      "tags": ["testing", "echo"],
      "listed": true,
      "access": "public",
      "defaultRoles": [],
      "commands": [{ "name": "start", "description": "Start", "shortcut": "Alt+S" }]
    }
  ],
  "chats": [
    {
      "id": "chat-alice-echo",
      "user": "alice",
      "bot": "echo_bot",
      "messages": [{ "id": "message-ready", "sender": "bot", "content": { "text": "Ready" } }]
    }
  ],
  "test": { "token": "${BOT_APPERCOT_TEST_TOKEN}" }
}
