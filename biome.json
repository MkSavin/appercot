{
  "files": {
    "includes": [
      "**",
      "!.agents",
      "!AGENTS.md",
      "!apps/server/schema.graphql",
      "!apps/web/src/shared/api/graphql/generated",
      "!packages/test/test-results",
      "!**/dist",
      "!**/.data*",
      "!**/.test-data"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
